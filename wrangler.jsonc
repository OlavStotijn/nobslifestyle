{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nobslifestyle",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-09-25",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./app/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "routes": [
    { "pattern": "nobslifestyle.com", "custom_domain": true },
    { "pattern": "www.nobslifestyle.com", "custom_domain": true }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "APP_URL": "https://nobslifestyle.com",
    "MAIL_FROM_ADDRESS": "NoBSLifestyle <noreply@nobslifestyle.com>",
    "TURNSTILE_SITE_KEY": "REPLACE_WITH_PUBLIC_SITE_KEY",
    "OPEN_FOOD_FACTS_USER_AGENT": "NoBSLifestyle/1.0 (olavstotijn@gmail.com)"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nobslifestyle",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "nobslifestyle-media"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "RATE_LIMIT_KV",
      "id": "REPLACE_WITH_KV_NAMESPACE_ID"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "send_email": [
    {
      "name": "SEND_EMAIL"
    }
  ]
}
